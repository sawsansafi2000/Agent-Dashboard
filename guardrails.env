WORKSPACE_PATH="./"
CHALLENGE_LOG_PATH="./challenge-log.md"

OPENAI_MODEL="gpt-4o"
OPENAI_MAX_COMPLETION_TOKENS="4000"
OPENAI_INPUT_CENTS_PER_MILLION_TOKENS="250"
OPENAI_OUTPUT_CENTS_PER_MILLION_TOKENS="1000"

ALLOW_GIT_PUSH="false"
INFRASTRUCTURE_READY="false"
IDEAS_PER_RUN="5"
SLEEP_TIME_MS="2000"
HEARTBEAT_TIMEOUT_MS="660000"
API_STATUS_CHECK_INTERVAL_MS="60000"
API_BUDGET_WARNING_CENTS="1000"
DISALLOWED_KEYWORDS="Heilversprechen,Garantierte Heilung"
