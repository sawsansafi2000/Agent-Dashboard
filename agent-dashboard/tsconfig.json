{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "src/controllers",
    "src/db",
    "src/middleware",
    "src/models",
    "src/routes/auth.ts",
    "src/services/agentService.ts",
    "src/services/authService.ts",
    "src/sockets",
    "src/types"
  ]
}