EMAIL_FROM="kontakt@natur-vitale.de"
BREVO_API_KEY=
SENDER_EMAIL="kontakt@natur-vitale.de"
SENDER_NAME="NaturVitale"
SUPPORT_PHONE="+49 176 68526814"
CONTENT_RESPONSIBLE_NAME="Sawsan Safi"
CONTENT_RESPONSIBLE_ADDRESS="Brahmsstr. 72, 27474 Cuxhaven"

# Mobile dashboard login; use a unique password with at least 20 characters
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Public deployment URL, without a trailing slash
PRODUCTION_APP_URL=https://agents.example.com
DASHBOARD_URL=https://agents.example.com/dashboard

# Runtime
NODE_ENV=production
PORT=3000
INTERNAL_AGENT_API_PORT=3101
API_TOKEN_LABEL=OPENAI_API_KEY
BYPASS_BUDGET_CHECK=false

# Docker Compose TLS hostname
DOMAIN=agents.example.com

# Optional external integrations; leave empty until the integration is enabled
SOCIAL_PUBLISHING_ENABLED=false
SOCIAL_AUTONOMOUS_PUBLISHING_ENABLED=false
SOCIAL_HEALTHCHECKS_ENABLED=true
SOCIAL_AUTOMATION_INTERVAL_MS=60000
SOCIAL_TOKEN_REFRESH_INTERVAL_MS=21600000
ANTHROPIC_API_KEY=
STRIPE_ACCOUNT_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
