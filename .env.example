# Required runtime secrets
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Official company, imprint and sender details
COMPANY_LEGAL_NAME="NaturVitale UG (haftungsbeschraenkt)"
COMPANY_STREET="Brahmsstr. 72"
COMPANY_POSTAL_CODE="27474"
COMPANY_CITY="Cuxhaven"
COMPANY_COUNTRY="Deutschland"
COMPANY_MANAGING_DIRECTOR="Sawsan Safi"
COMPANY_REGISTER_COURT="Amtsgericht Bremen"
COMPANY_REGISTER_NUMBER="HRB 40637 HB"
COMPANY_VAT_NOTICE="Es wird zurzeit keine Umsatzsteuer ausgewiesen (wird mit dem Finanzamt geklaert)."
